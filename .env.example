NODE_ENV=development
PORT=3000

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PrereqPilot"
NEXT_PUBLIC_APP_TITLE="PrereqPilot - Your Academic Planning Assistant"
NEXT_PUBLIC_APP_DESCRIPTION="Your AI-powered study buddy for mastering prerequisites."
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_VERSION_STATUS=beta

NEXT_PUBLIC_SUPABASE_URL=supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=supabase-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=supabase-secret-key-here

OPENAI_API_KEY=your-openai-api-key-here

RESEND_API_KEY=your-resend-api-key-here
CONTACT_FROM_EMAIL=team@prereqpilot.com

# Features not yet ready for production
NEXT_PUBLIC_ENABLE_OFFICIAL_PROGRAMS=false
NEXT_ENABLE_OFFICIAL_INSTITUTIONS=false